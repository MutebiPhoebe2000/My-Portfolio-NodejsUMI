head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Pheebz-Portfolio
  link(href='https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=Jost:wght@300;400;500;600&display=swap' rel='stylesheet')
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css')
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css' rel='stylesheet')
  link(rel='stylesheet' href='/css/style.css')
  link(rel='stylesheet' href='/css/form.css')
nav.navbar
  a.navbar-brand(href='/') My Portfolio
  ul.nav-links
    li
      a(href='/') Home
    li
      a(href='/about') Pheebz
    li
      a(href='/contact') Connect
section.contact-section
  .contact-intro
    h2.contact-title
      | Get In 
      em Touch
      br
      | With Me.
    .contact-image
      img(src='/assets/codingC.jpeg' alt='coding')
      p.image-text
        | I&apos;m open to freelance, part-time, and full-time opportunities.
        | Got a project or just wanna say hi?
      .social-links
        a(href='https://www.instagram.com/mutebiphoebe/' target='_blank' rel='noopener noreferrer')
          i.bi.bi-instagram
          |  Instagram
        a(href='https://x.com/Phibipheebz' target='_blank' rel='noopener noreferrer')
          i.bi.bi-twitter
          |  Twitter
        a(href='https://wa.me/256784765697')
          i.bi.bi-whatsapp
          |  WhatsApp
        a(href='https://www.linkedin.com/in/phoebe-mutebi-25844226a' target='_blank' rel='noopener noreferrer')
          i.bi.bi-linkedin
          |                         LinkedIn
        a(href='https://github.com/MutebiPhoebe2000' target='_blank' rel='noopener noreferrer')
          i.bi.bi-github
          |  GitHub
  .contact-form-wrap
    h3 Send Me a Message
    p Fill in the form below and I will get back to you as soon as possible.
    form(action='/form/submit' method='POST')
      .form-row
        .form-group
          label(for='userName') Full Name *
          input#name(type='text' name='name' maxlength='100' placeholder='e.g. Kinalwa Natasha')
        .form-group
          label(for='company') Company / Organisation
          input#company(type='text' name='company' placeholder='e.g. Perfect Woods')
      .form-row
        .form-group
          label(for='email') Email Address *
          input#email(type='email' name='email' maxlength='254' placeholder='you@gmail.com')
        .form-group
          label(for='phone') Phone / Contact
          input#phone(type='tel' name='phone' placeholder='+(256) 700 777 000')
      .form-group
        label(for='address') Address / Location
        input#address(type='text' name='address' placeholder='e.g. Kampala, Uganda')
      .form-group
        label(for='subject') What Are You Looking For?
        select#subject(name='subject')
          option(value='' disabled='' selected='') Select an option
          option(value='freelance') Freelance Project
          option(value='parttime') Part-time Opportunity
          option(value='fulltime') Full-time Position
          option(value='collaboration') Collaboration
          option(value='other') Other
      .form-group
        label(for='message') Your Message *
        textarea#message(name='message' maxlength='5000' placeholder="Tell me about your project, opportunity, or anything you'd like to share...")
      div(style='position:absolute;left:-9999px;' aria-hidden='true')
        input(type='text' name='website' tabindex='-1' autocomplete='off')
      button.btn-submit(type='submit')
        | Send Message &nbsp; 
        i.bi.bi-send
      span#formMsg(style="display:block; margin-top:1rem; font-size:0.82rem; font-family:'Jost',sans-serif;")
.cv-row
  p Want to know more about my experience and qualifications?
  a.btn-cv(href='/general-CV.pdf' download='')
    | Download My CV
footer
  span.footer-brand Phoebe Mutebi
  ul.footer-nav
    li
      a(href='/') Home
    li
      a(href='/about') Pheebz
    li
      a(href='/contact') Connect
  small &copy; 2025 Phoebe Mutebi. All rights reserved.
script(nonce=nonce).
  const form = document.querySelector('form');
  form.addEventListener('submit', function (e) {
  const name = document.getElementById('name').value.trim();
  const email = document.getElementById('email').value.trim();
  const message = document.getElementById('message').value.trim();
  if (!name || !email || !message) {
  e.preventDefault();
  document.getElementById('formMsg').innerHTML = 'Please fill in your Name, Email and Message before sending.';
  document.getElementById('formMsg').style.color = 'red';
  return;
  }
  if (!email.includes('@') || !email.includes('.')) {
  e.preventDefault();
  document.getElementById('formMsg').innerHTML = 'Please enter a valid email address.';
  document.getElementById('formMsg').style.color = 'red';
  return;
  }
  });
script(src='/js/script.js')
